(defun mine_ai ()
  (if (or (eq (total_objects) 0) (not (eq (with_object (get_object 0) (aistate)) 0)))
      (select (aistate)
	      (0 (if (touching_bg)
		     (progn (set_state running)
			    (if (eq (xvel) 1)
				(progn
				  (with_object (bg)
					       (make_view_solid (find_rgb 250 10 10)))
				  (hurt_radius (x) (y) 40 35 nil 20))
			      (hurt_radius (x) (y) 40 25 nil 20))
			    (go_state 1))
		   (next_picture))
		   T)
	      (1 (next_picture)))
    T))




