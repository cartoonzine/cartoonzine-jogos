	      '(funs (ai_fun weapon_icon_ai)
		     (get_cache_list_fun ammo_cache)
		     (draw_fun on_draw))
	      '(range 5 5)
	      '(flags (add_front T))
	      `(abilities (start_hp ,increment))
	      `(states  "art/chars/ammo.spe" (stopped ,icon_name)))))

