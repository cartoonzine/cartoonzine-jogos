(defun tele_beam_ai ()
  (next_picture)
  (if (> (direction) 0)
      (if (eq (fade_count) 12)
	  (progn
	    (play_sound APPEAR_SND 100 (x) (y))
	    (set_direction -1))
	(set_fade_count (+ (fade_count) 1)))
    (if (eq (fade_count) 5)
	(progn
	  (play_sound APPEAR_SND 100 (x) (y))
	  (set_direction 1))
      (set_fade_count (- (fade_count) 1)))))


