  (range 20 20)
  (states "art/misc.spe" (stopped "fly")))


(defun health_power_ai ()
  (next_picture)
  (if (touching_bg)
      (progn
	(with_object (bg)
		     (progn
		       (setq special_power HEALTH_POWER)
		       (give_player_health 100)))
	nil)
    T))

