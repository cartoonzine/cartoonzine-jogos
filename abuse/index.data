  (if (and (touching_bg) (with_object (bg) (pressing_action_key)))
      (if (eq (aistate) end_level)
	  (request_end_game)
	(progn
	  (show_stats)
	  (request_level_load (concatenate 'string "levels/level" (digstr (aistate) 2) ".spe")))))
  T)


