		   (SNEAKY_POWER
		    (if (local_player)
			(put_image (- (view_x2) 20) (+ (view_y1) 5) sneaky_image))
				 (sneaky_draw used_special_power (player_number)))
		   (SHLAMP_POWER (player_draw (bottom_draw (player_number)))
